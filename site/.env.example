# Assistant («Навигатор»). Copy to .env.local for local work. Never commit real values.
# With no file at all the assistant uses a local Ollama at 127.0.0.1:11434 and qwen3:8b.

# Which model runs the assistant. Use the exact names from `ollama list`.
#   qwen3:8b        — main model; native tool calling
#   mistral:latest  — for comparison; runs through the routed JSON protocol
ASSISTANT_PROVIDER=ollama
ASSISTANT_MODEL=qwen3:8b

# Where Ollama is. Locally this is the default. On a hosting platform (Vercel) there is no
# default: give the https address of a protected gateway (scripts/ollama_gateway.mjs) and its token.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_API_KEY=

# Optional tuning.
# ASSISTANT_TOOL_MODE=native|json   # default: native for qwen3, json for other models
# ASSISTANT_THINK=1                 # let qwen3 reason before answering (slower)
# OLLAMA_NUM_CTX=8192               # context window, tokens

# The published site (Vercel) cannot reach a laptop, so there the assistant runs on Google Gemini.
# Setting GEMINI_API_KEY in the hosting environment is enough: with it and without OLLAMA_BASE_URL
# the hosted function picks Gemini by itself. Locally the default stays Ollama; to try Gemini
# locally add ASSISTANT_PROVIDER=gemini. The key is read on the server only.
# GEMINI_API_KEY=
# ASSISTANT_MODEL=gemini-3.5-flash-lite     # the default for Gemini
# GEMINI_THINKING_LEVEL=low                 # minimal | low | medium | high

# Optional hosted provider instead of local models (not needed otherwise):
# ASSISTANT_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ASSISTANT_MODEL=claude-opus-5-5
# ASSISTANT_EFFORT=low
